---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface AwardCategory {
  id: string;
  title: string;
  recipient?: string;
  photo?: ImageMetadata;
}

interface Props {
  categories: AwardCategory[];
}

const { categories } = Astro.props;
---

<div class="awards-grid">
  {categories.map(category => (
    <div class="award-card card" id={category.id}>
      <div class="award-image-wrapper">
        {category.photo ? (
          <Image
            src={category.photo}
            alt={category.recipient
              ? `${category.recipient}, ${category.title}`
              : category.title}
            width={240}
            height={240}
            class="award-photo"
          />
        ) : (
          <img
            src={`/images/awards/placeholders/${category.id}.svg`}
            alt=""
            aria-hidden="true"
            class="award-placeholder"
          />
        )}
      </div>
      <h3 class="award-title">{category.title}</h3>
      <p class="award-recipient">
        {category.recipient ?? 'To be announced'}
      </p>
    </div>
  ))}
</div>

<style>
  .awards-grid {
    display: grid;
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 640px) {
    .awards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .awards-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .award-card {
    text-align: center;
    padding: var(--space-xl) var(--space-lg);
  }

  .award-image-wrapper {
    margin: 0 auto var(--space-lg);
    width: 120px;
    height: 120px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-light-gray);
  }

  .award-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .award-placeholder {
    width: 56px;
    height: 56px;
    opacity: 0.55;
  }

  .award-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-xs);
  }

  .award-recipient {
    color: var(--color-accent);
    font-weight: 600;
    font-size: var(--text-base);
    margin: 0;
  }
</style>
