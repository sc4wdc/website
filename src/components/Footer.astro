---
import FacebookIcon from './icons/FacebookIcon.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import { getSiteSettings } from '../utils/site';

const currentYear = new Date().getFullYear();
const siteSettings = await getSiteSettings();
const { meeting, organization, site, social } = siteSettings;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-section">
        <p class="footer-heading">{site.name}</p>
        <p>{organization.status}</p>
        <p class="mission">{organization.mission}</p>
      </div>

      <div class="footer-section">
        <p class="footer-heading">Monthly Meetings</p>
        <p><strong>{meeting.schedule}</strong></p>
        <p>{meeting.time}</p>
        <p>{meeting.location.name}</p>
        <p>
          {meeting.location.address}<br />
          {meeting.location.city}, {meeting.location.state} {meeting.location.zip}
        </p>
      </div>

      <div class="footer-section">
        <p class="footer-heading">Connect With Us</p>
        <div class="social-links">
          <a href={social.facebook} target="_blank" rel="noopener noreferrer" class="social-link">
            <FacebookIcon />
            Facebook <span class="sr-only">(opens in new tab)</span>
          </a>
          <a href={social.instagram} target="_blank" rel="noopener noreferrer" class="social-link">
            <InstagramIcon />
            Instagram <span class="sr-only">(opens in new tab)</span>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} {site.name}. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-dark);
    color: var(--color-white);
    padding: var(--space-xl) 0 var(--space-md);
    margin-top: auto;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-lg);
  }

  @media (min-width: 768px) {
    .footer-content {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .footer-heading {
    color: var(--color-sand);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--space-sm);
  }

  .footer-section p {
    font-size: var(--text-base);
    margin-bottom: var(--space-xs);
    line-height: 1.6;
  }

  .mission {
    font-style: italic;
    opacity: 0.9;
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-white);
    padding: var(--space-xs) var(--space-sm);
    min-height: 44px;
    transition: color var(--transition-fast);
  }

  .social-link:hover {
    color: var(--color-sand);
  }

  .social-link svg {
    flex-shrink: 0;
  }

  .footer-bottom {
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }

  .footer-bottom p {
    font-size: var(--text-base);
    opacity: 0.8;
  }
</style>

