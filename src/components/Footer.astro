---
import clubInfo from '../data/club-info.json';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-section">
        <h3>{clubInfo.clubName}</h3>
        <p>{clubInfo.nonprofit.status}</p>
        <p class="mission">{clubInfo.nonprofit.mission}</p>
      </div>

      <div class="footer-section">
        <h3>Monthly Meetings</h3>
        <p><strong>{clubInfo.meeting.schedule}</strong></p>
        <p>{clubInfo.meeting.time}</p>
        <p>{clubInfo.meeting.location.name}</p>
        <p>
          {clubInfo.meeting.location.address}<br />
          {clubInfo.meeting.location.city}, {clubInfo.meeting.location.state} {clubInfo.meeting.location.zip}
        </p>
      </div>

      <div class="footer-section">
        <h3>Connect With Us</h3>
        <div class="social-links">
          <a href={clubInfo.social.facebook} target="_blank" rel="noopener noreferrer" class="social-link">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            Facebook
          </a>
          <a href={clubInfo.social.instagram} target="_blank" rel="noopener noreferrer" class="social-link">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            Instagram
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} {clubInfo.clubName}. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-dark);
    color: var(--color-white);
    padding: var(--space-xl) 0 var(--space-md);
    margin-top: auto;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-lg);
  }

  @media (min-width: 768px) {
    .footer-content {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .footer-section h3 {
    color: var(--color-sand);
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
  }

  .footer-section p {
    font-size: 0.95rem;
    margin-bottom: var(--space-xs);
    line-height: 1.6;
  }

  .mission {
    font-style: italic;
    opacity: 0.9;
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-white);
    padding: var(--space-xs) 0;
    transition: color 0.2s ease;
  }

  .social-link:hover {
    color: var(--color-sand);
  }

  .social-link svg {
    flex-shrink: 0;
  }

  .footer-bottom {
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }

  .footer-bottom p {
    font-size: 0.9rem;
    opacity: 0.8;
  }
</style>

