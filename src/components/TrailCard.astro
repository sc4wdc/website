---
interface Props {
  title: string;
  difficulty?: string;
  location?: string;
  description?: string;
  href?: string;
}

const { title, difficulty, location, description, href } = Astro.props;
---

<div class="trail-card">
  {href ? (
    <a href={href} class="trail-card-link">
      <div class="trail-header">
        <h3>{title}</h3>
        {difficulty && (
          <span class={`difficulty-badge difficulty-${difficulty.toLowerCase()}`}>
            {difficulty}
          </span>
        )}
      </div>
      {location && <p class="trail-location">📍 {location}</p>}
      {description && <p class="trail-description">{description}</p>}
    </a>
  ) : (
    <div>
      <div class="trail-header">
        <h3>{title}</h3>
        {difficulty && (
          <span class={`difficulty-badge difficulty-${difficulty.toLowerCase()}`}>
            {difficulty}
          </span>
        )}
      </div>
      {location && <p class="trail-location">📍 {location}</p>}
      {description && <p class="trail-description">{description}</p>}
    </div>
  )}
</div>

<style>
  .trail-card {
    background: var(--color-white);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: all 0.3s ease;
    height: 100%;
  }

  .trail-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .trail-card-link {
    display: block;
    padding: var(--space-lg);
    color: inherit;
    text-decoration: none;
  }

  .trail-card > div {
    padding: var(--space-lg);
  }

  .trail-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .trail-header h3 {
    margin: 0;
    color: var(--color-primary);
    font-size: 1.25rem;
  }

  .trail-card-link:hover h3 {
    color: var(--color-accent);
  }

  .difficulty-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .difficulty-easy {
    background-color: #4caf50;
    color: white;
  }

  .difficulty-moderate {
    background-color: var(--color-sand);
    color: var(--color-dark);
  }

  .difficulty-difficult {
    background-color: var(--color-accent);
    color: white;
  }

  .difficulty-extreme {
    background-color: #d32f2f;
    color: white;
  }

  .trail-location {
    color: var(--color-gray);
    font-size: 0.95rem;
    margin-bottom: var(--space-sm);
  }

  .trail-description {
    color: var(--color-gray);
    line-height: 1.6;
    margin: 0;
  }
</style>

