---
import { getSiteNavigation, getSiteSettings } from '../utils/site';

const currentPath = Astro.url.pathname;
const [navItems, siteSettings] = await Promise.all([
  getSiteNavigation(),
  getSiteSettings(),
]);

function isActive(itemHref: string): boolean {
  if (itemHref === '/') return currentPath === '/';
  return currentPath === itemHref || currentPath.startsWith(itemHref + '/');
}
---

<header class="site-header">
  <div class="container">
    <div class="header-content">
      <div class="logo">
        <a href="/">
          <!-- Placeholder for club logo -->
          <div class="logo-placeholder">
            <svg width="50" height="50" viewBox="0 0 50 50" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <rect width="50" height="50" rx="8" fill="currentColor"/>
              <text x="25" y="32" font-size="24" font-weight="bold" text-anchor="middle" fill="white">4WD</text>
            </svg>
          </div>
          <div class="site-title">
            <span class="club-name">{siteSettings.site.name}</span>
            <span class="tagline">{siteSettings.site.tagline}</span>
          </div>
        </a>
      </div>

      <button class="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false" id="menuToggle">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <nav class="main-nav" id="mainNav" aria-label="Main navigation">
        <ul>
          {navItems.map(item => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { active: isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-primary);
    color: var(--color-white);
    box-shadow: var(--shadow-lg);
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-sm) 0;
    gap: var(--space-md);
  }

  .logo a {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-white);
    text-decoration: none;
  }

  .logo-placeholder {
    color: var(--color-sand);
    flex-shrink: 0;
  }

  .site-title {
    display: flex;
    flex-direction: column;
  }

  .club-name {
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.2;
  }

  .tagline {
    font-size: var(--text-sm);
    opacity: 0.9;
    font-style: italic;
  }

  /* Mobile Menu Toggle */
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.75rem;
    z-index: 1001;
  }

  .mobile-menu-toggle span {
    display: block;
    width: 25px;
    height: 3px;
    background-color: var(--color-white);
    transition: all var(--transition-base);
  }

  .mobile-menu-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(8px, 8px);
  }

  .mobile-menu-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }

  /* Navigation */
  .main-nav ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .main-nav li {
    margin: 0;
  }

  .nav-link {
    display: block;
    padding: var(--space-sm) var(--space-sm);
    color: var(--color-white);
    font-weight: 500;
    border-radius: var(--border-radius);
    transition: all var(--transition-fast);
  }

  .nav-link:hover {
    background-color: var(--color-primary-light);
    color: var(--color-white);
  }

  .nav-link.active {
    background-color: var(--color-secondary);
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    .club-name {
      font-size: var(--text-base);
    }

    .tagline {
      font-size: var(--text-xs);
    }

    .mobile-menu-toggle {
      display: flex;
    }

    .main-nav {
      position: fixed;
      top: 0;
      right: -100%;
      width: 280px;
      height: 100vh;
      background-color: var(--color-primary);
      padding: var(--space-2xl) var(--space-md);
      transition: right var(--transition-base);
      box-shadow: -4px 0 8px rgba(0, 0, 0, 0.2);
    }

    .main-nav.active {
      right: 0;
    }

    .main-nav ul {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .nav-link {
      padding: var(--space-md);
      font-size: var(--text-md);
    }
  }
</style>

<script>
  const menuToggle = document.getElementById('menuToggle');
  const mainNav = document.getElementById('mainNav');

  if (menuToggle && mainNav) {
    const toggle = menuToggle;
    const nav = mainNav;
    const focusableEls = nav.querySelectorAll<HTMLElement>('a');

    function openMenu() {
      toggle.classList.add('active');
      nav.classList.add('active');
      toggle.setAttribute('aria-expanded', 'true');
    }

    function closeMenu() {
      toggle.classList.remove('active');
      nav.classList.remove('active');
      toggle.setAttribute('aria-expanded', 'false');
    }

    function isOpen() {
      return nav.classList.contains('active');
    }

    toggle.addEventListener('click', () => {
      if (isOpen()) {
        closeMenu();
      } else {
        openMenu();
        focusableEls[0]?.focus();
      }
    });

    nav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => closeMenu());
    });

    document.addEventListener('click', (e) => {
      if (isOpen() && !nav.contains(e.target as Node) && !toggle.contains(e.target as Node)) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        closeMenu();
        toggle.focus();
      }

      if (e.key === 'Tab' && isOpen() && focusableEls.length > 0) {
        const first = focusableEls[0];
        const last = focusableEls[focusableEls.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>

