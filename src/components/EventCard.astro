---
import { parseLocalDate } from '../utils/date';

interface Props {
  title: string;
  date: Date;
  location?: string;
  href?: string;
  cancelled?: boolean;
}

const { title, date, location, href, cancelled } = Astro.props;
const localDate = parseLocalDate(date);
---

<div class:list={["event-card", { cancelled }]}>
  <div class="event-date">
    <span class="date-day">{localDate.toLocaleDateString('en-US', { day: 'numeric', timeZone: 'UTC' })}</span>
    <span class="date-month">{localDate.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' })}</span>
  </div>
  <div class="event-details">
    {href ? (
      <h3><a href={href}>{title}{cancelled && <span class="cancelled-label"> — Cancelled</span>}</a></h3>
    ) : (
      <h3>{title}{cancelled && <span class="cancelled-label"> — Cancelled</span>}</h3>
    )}
    {location && <p class="event-location"><span aria-hidden="true">📍 </span>{location}</p>}
  </div>
</div>

<style>
  .event-card {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--color-white);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow);
    transition: all var(--transition-base);
  }

  .event-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .event-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--color-accent);
    color: var(--color-white);
    padding: var(--space-sm);
    border-radius: var(--border-radius);
    min-width: 70px;
    flex-shrink: 0;
  }

  .date-day {
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1;
  }

  .date-month {
    font-size: var(--text-base);
    text-transform: uppercase;
    font-weight: 600;
  }

  .event-details {
    flex: 1;
  }

  .event-details h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-xs);
  }

  .event-details h3 a {
    color: var(--color-primary);
  }

  .event-details h3 a:hover {
    color: var(--color-accent);
  }

  .event-location {
    color: var(--color-gray);
    font-size: var(--text-base);
  }

  .event-card.cancelled {
    opacity: 0.6;
  }

  .event-card.cancelled .event-date {
    background-color: var(--color-gray);
  }

  .cancelled-label {
    color: var(--color-accent);
    font-weight: 600;
  }
</style>

