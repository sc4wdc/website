---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const membershipPage = await getEntry('pages', 'membership');
const { Content } = await membershipPage.render();
---

<BaseLayout title={membershipPage.data.title} description={membershipPage.data.description}>
  <section class="section content-page">
    <div class="container">
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .content-page {
    background-color: var(--color-white);
  }

  .prose {
    max-width: 800px;
    margin: 0 auto;
  }

  .prose :global(h2) {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 2px solid var(--color-light-gray);
  }

  .prose :global(h2:first-of-type) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .prose :global(h3) {
    margin-top: var(--space-lg);
    color: var(--color-secondary);
  }

  .prose :global(ul) {
    list-style: none;
    margin-left: 0;
  }

  .prose :global(li) {
    padding-left: var(--space-lg);
    position: relative;
  }

  .prose :global(li::before) {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: bold;
  }

  .prose :global(strong) {
    color: var(--color-primary);
  }

  .prose :global(hr) {
    border: none;
    border-top: 2px solid var(--color-light-gray);
    margin: var(--space-xl) 0;
  }
</style>

