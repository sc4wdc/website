---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection } from 'astro:content';
import clubInfo from '../data/club-info.json';
import { parseLocalDate, getTodayLocal } from '../utils/date';

const allEvents = await getCollection('events');

// Get current date in local timezone for comparison
const today = getTodayLocal();

const upcomingEvents = allEvents
  .filter(event => parseLocalDate(event.data.date) >= today)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const pastEvents = allEvents
  .filter(event => parseLocalDate(event.data.date) < today)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Events & Calendar" description="Upcoming events, meetings, and trail rides with Santa Cruz 4WDC">
  <section class="section">
    <div class="container">
      <h1>Events & Calendar</h1>
      <p class="intro">
        Join us for trail rides, meetings, community service projects, and social events.
        Check back regularly for updates and new events!
        Please note that all events are subject to change or cancellation.
      </p>

      <!-- Monthly Meeting Reminder -->
      <div class="card meeting-reminder">
        <h2>📅 Regular Monthly Meeting</h2>
        <div class="meeting-details">
          <p><strong>{clubInfo.meeting.schedule}</strong> at <strong>{clubInfo.meeting.time}</strong></p>
          <p>{clubInfo.meeting.location.name}, {clubInfo.meeting.location.city}</p>
          <p class="note">{clubInfo.meeting.earlyArrival}</p>
        </div>
        <a href="/contact" class="btn">Meeting Details & Directions</a>
      </div>

      <!-- Google Calendar Section -->
      <div class="calendar-section card">
        <h2>📆 Club Calendar</h2>
        {clubInfo.calendar.embedUrl ? (
          <div class="calendar-embed">
            <iframe
              src={clubInfo.calendar.embedUrl}
              style="border: 0"
              width="100%"
              height="600"
              title="SC4WDC Events Calendar"
            ></iframe>
            {clubInfo.calendar.publicUrl && (
              <div class="calendar-links">
                <a href={clubInfo.calendar.publicUrl} target="_blank" rel="noopener noreferrer" class="btn">
                  Open in Google Calendar
                </a>
              </div>
            )}
          </div>
        ) : (
          <div class="calendar-setup-instructions">
            <p><strong>Google Calendar not yet configured.</strong></p>
            <p>To add the club's Google Calendar to this page, follow these steps:</p>
            <ol>
              <li>Go to <a href="https://calendar.google.com" target="_blank" rel="noopener noreferrer">Google Calendar</a></li>
              <li>Find your club calendar in the left sidebar</li>
              <li>Click the three dots next to the calendar name → Settings and sharing</li>
              <li>Scroll to "Access permissions" and check "Make available to public"</li>
              <li>Scroll to "Integrate calendar" section</li>
              <li>Copy the <strong>Calendar ID</strong> (looks like: abc123@group.calendar.google.com)</li>
              <li>Copy the <strong>iframe embed code</strong></li>
              <li>Extract the <code>src</code> URL from the iframe (starts with https://calendar.google.com/calendar/embed)</li>
              <li>Update <code>src/data/club-info.json</code> with:
                <ul>
                  <li><code>"embedUrl": "paste-the-src-url-here"</code></li>
                  <li><code>"publicUrl": "https://calendar.google.com/calendar/u/0?cid=YOUR_CALENDAR_ID"</code></li>
                </ul>
              </li>
              <li>Commit and push your changes</li>
            </ol>
            <p>For now, check our Facebook group for the latest event information:</p>
            <div class="calendar-links">
              <a href={clubInfo.social.facebook} target="_blank" rel="noopener noreferrer" class="btn">
                View Events on Facebook
              </a>
            </div>
          </div>
        )}
      </div>

      <!-- Upcoming Events -->
      {upcomingEvents.length > 0 ? (
        <div class="events-section">
          <h2>Upcoming Events</h2>
          <div class="events-grid">
          {upcomingEvents.map(event => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              href={`/events/${event.slug}`}
            />
          ))}
          </div>
        </div>
      ) : (
        <div class="card no-events">
          <h2>No Upcoming Events</h2>
          <p>Check back soon or join our Facebook group to stay updated on new events!</p>
        </div>
      )}

      <!-- Past Events -->
      {pastEvents.length > 0 && (
        <div class="past-events-section">
          <h2>Past Events</h2>
          <div class="events-grid">
          {pastEvents.slice(0, 6).map(event => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              href={`/events/${event.slug}`}
            />
          ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    text-align: center;
    font-size: 1.125rem;
    max-width: 700px;
    margin: 0 auto var(--space-xl);
    color: var(--color-gray);
  }

  .meeting-reminder {
    max-width: 700px;
    margin: 0 auto var(--space-xl);
    text-align: center;
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary) 100%);
    color: var(--color-white);
  }

  .meeting-reminder h2 {
    color: var(--color-white);
  }

  .meeting-details {
    margin: var(--space-lg) 0;
  }

  .meeting-details p {
    margin-bottom: var(--space-xs);
    font-size: 1.1rem;
  }

  .meeting-details .note {
    font-style: italic;
    opacity: 0.9;
    font-size: 1rem;
    margin-top: var(--space-sm);
  }

  .meeting-reminder .btn {
    background-color: var(--color-white);
    color: var(--color-primary);
    border-color: var(--color-white);
  }

  .meeting-reminder .btn:hover {
    background-color: var(--color-off-white);
    border-color: var(--color-off-white);
  }

  .calendar-section {
    max-width: 900px;
    margin: 0 auto var(--space-xl);
    text-align: center;
  }

  .calendar-embed {
    margin-top: var(--space-lg);
  }

  .calendar-embed iframe {
    border-radius: var(--border-radius);
    box-shadow: var(--shadow);
  }

  .calendar-setup-instructions {
    text-align: left;
    max-width: 700px;
    margin: var(--space-lg) auto;
    padding: var(--space-lg);
    background-color: var(--color-light-gray);
    border-radius: var(--border-radius);
  }

  .calendar-setup-instructions p {
    margin-bottom: var(--space-md);
  }

  .calendar-setup-instructions ol {
    margin-left: var(--space-lg);
    margin-bottom: var(--space-md);
  }

  .calendar-setup-instructions li {
    margin-bottom: var(--space-sm);
    line-height: 1.6;
  }

  .calendar-setup-instructions ul {
    margin-left: var(--space-lg);
    margin-top: var(--space-xs);
  }

  .calendar-setup-instructions code {
    background-color: var(--color-white);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-size: 0.9em;
  }

  .calendar-setup-instructions a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .calendar-setup-instructions a:hover {
    color: var(--color-accent);
  }

  .calendar-links {
    margin-top: var(--space-lg);
    text-align: center;
  }

  .events-section, .past-events-section {
    margin-top: var(--space-2xl);
  }

  .events-section h2, .past-events-section h2 {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .past-events-section {
    opacity: 0.8;
  }

  .past-events-section h2 {
    color: var(--color-gray);
  }

  .events-grid {
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .events-grid {
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    }
  }

  .no-events {
    text-align: center;
    max-width: 600px;
    margin: var(--space-xl) auto;
    padding: var(--space-2xl);
  }
</style>

