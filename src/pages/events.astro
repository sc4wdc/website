---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection } from 'astro:content';
import { MEETING, CALENDAR } from '../consts';
import { parseLocalDate, getTodayLocal } from '../utils/date';

const allEvents = await getCollection('events');

// Get current date in local timezone for comparison
const today = getTodayLocal();

const upcomingEvents = allEvents
  .filter(event => parseLocalDate(event.data.date) >= today)
  .sort((a, b) => parseLocalDate(a.data.date).getTime() - parseLocalDate(b.data.date).getTime());

const pastEvents = allEvents
  .filter(event => parseLocalDate(event.data.date) < today)
  .sort((a, b) => parseLocalDate(b.data.date).getTime() - parseLocalDate(a.data.date).getTime());
---

<BaseLayout title="Events & Calendar" description="Upcoming events, meetings, and trail rides with Santa Cruz 4WDC">
  <section class="section">
    <div class="container">
      <h1>Events & Calendar</h1>
      <p class="intro">
        Join us for trail rides, meetings, community service projects, and social events.
        Check back regularly for updates and new events!
        Please note that all events are subject to change or cancellation.
      </p>

      <!-- Monthly Meeting Reminder -->
      <div class="card meeting-reminder">
        <h2>📅 Regular Monthly Meeting</h2>
        <div class="meeting-details">
          <p><strong>{MEETING.schedule}</strong> at <strong>{MEETING.time}</strong></p>
          <p>{MEETING.location.name}, {MEETING.location.city}</p>
          <p class="note">{MEETING.earlyArrival}</p>
        </div>
        <a href="/contact" class="btn">Meeting Details & Directions</a>
      </div>

      <!-- Google Calendar Section -->
      <div class="calendar-section card">
        <h2>📆 Club Calendar</h2>
        <div class="calendar-embed">
          <iframe
            src={CALENDAR.embedUrl}
            style="border: 0"
            width="100%"
            height="600"
            title="SC4WDC Events Calendar"
          ></iframe>
          <div class="calendar-links">
            <a href={CALENDAR.publicUrl} target="_blank" rel="noopener noreferrer" class="btn">
              Open in Google Calendar
            </a>
          </div>
        </div>
      </div>

      <!-- Upcoming Events -->
      {upcomingEvents.length > 0 ? (
        <div class="events-section">
          <h2>Upcoming Events</h2>
          <div class="events-grid">
          {upcomingEvents.map(event => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              href={`/events/${event.slug}`}
            />
          ))}
          </div>
        </div>
      ) : (
        <div class="card no-events">
          <h2>No Upcoming Events</h2>
          <p>Check back soon or join our Facebook group to stay updated on new events!</p>
        </div>
      )}

      <!-- Past Events -->
      {pastEvents.length > 0 && (
        <div class="past-events-section">
          <h2>Past Events</h2>
          <div class="events-grid">
          {pastEvents.slice(0, 6).map(event => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              href={`/events/${event.slug}`}
            />
          ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .meeting-reminder {
    max-width: 700px;
    margin: 0 auto var(--space-xl);
    text-align: center;
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary) 100%);
    color: var(--color-white);
  }

  .meeting-reminder h2 {
    color: var(--color-white);
  }

  .meeting-details {
    margin: var(--space-lg) 0;
  }

  .meeting-details p {
    margin-bottom: var(--space-xs);
    font-size: 1.1rem;
  }

  .meeting-details .note {
    font-style: italic;
    opacity: 0.9;
    font-size: 1rem;
    margin-top: var(--space-sm);
  }

  .meeting-reminder .btn {
    background-color: var(--color-white);
    color: var(--color-primary);
    border-color: var(--color-white);
  }

  .meeting-reminder .btn:hover {
    background-color: var(--color-off-white);
    border-color: var(--color-off-white);
  }

  .calendar-section {
    max-width: 900px;
    margin: 0 auto var(--space-xl);
    text-align: center;
  }

  .calendar-embed {
    margin-top: var(--space-lg);
  }

  .calendar-embed iframe {
    border-radius: var(--border-radius);
    box-shadow: var(--shadow);
  }

  .calendar-links {
    margin-top: var(--space-lg);
    text-align: center;
  }

  .events-section, .past-events-section {
    margin-top: var(--space-2xl);
  }

  .events-section h2, .past-events-section h2 {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .past-events-section h2 {
    color: var(--color-gray);
  }

  .past-events-section :global(.event-card) {
    opacity: 0.7;
  }

  .past-events-section :global(.event-card:hover) {
    opacity: 1;
  }

  .events-grid {
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .events-grid {
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    }
  }

  .no-events {
    text-align: center;
    max-width: 600px;
    margin: var(--space-xl) auto;
    padding: var(--space-2xl);
  }
</style>

