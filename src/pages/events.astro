---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection, getEntry } from 'astro:content';
import { parseLocalDate, getTodayLocal } from '../utils/date';
import { getSiteSettings } from '../utils/site';

const [allEvents, eventsPage, siteSettings] = await Promise.all([
  getCollection('events'),
  getEntry('pages', 'events'),
  getSiteSettings(),
]);

if (!eventsPage || eventsPage.data.pageType !== 'events') {
  throw new Error('Events page content not found');
}

// Get current date in local timezone for comparison
const today = getTodayLocal();

const upcomingEvents = allEvents
  .filter(event => parseLocalDate(event.data.date) >= today)
  .sort((a, b) => parseLocalDate(a.data.date).getTime() - parseLocalDate(b.data.date).getTime());

const pastEvents = allEvents
  .filter(event => parseLocalDate(event.data.date) < today)
  .sort((a, b) => parseLocalDate(b.data.date).getTime() - parseLocalDate(a.data.date).getTime());

const { calendar, meeting } = siteSettings;
---

<BaseLayout title={eventsPage.data.title} description={eventsPage.data.description}>
  <section class="section">
    <div class="container">
      <h1>{eventsPage.data.title}</h1>
      <p class="intro">{eventsPage.data.intro}</p>

      <!-- Monthly Meeting Reminder -->
      <div class="card meeting-reminder">
        <h2><span aria-hidden="true">📅 </span>{eventsPage.data.meetingSection.title}</h2>
        <div class="meeting-details">
          <p><strong>{meeting.schedule}</strong> at <strong>{meeting.time}</strong></p>
          <p>{meeting.location.name}, {meeting.location.city}</p>
          <p class="note">{meeting.earlyArrival}</p>
        </div>
        <a href="/contact" class="btn btn-inverse">{eventsPage.data.meetingSection.ctaLabel}</a>
      </div>

      <!-- Google Calendar Section -->
      <div class="calendar-section card">
        <h2><span aria-hidden="true">📆 </span>{eventsPage.data.calendarSection.title}</h2>
        <div class="calendar-embed">
          <iframe
            src={calendar.embedUrl}
            width="100%"
            title="SC4WDC Events Calendar"
          ></iframe>
          <div class="calendar-links">
            <a href={calendar.publicUrl} target="_blank" rel="noopener noreferrer" class="btn">
              {eventsPage.data.calendarSection.linkLabel} <span class="sr-only">(opens in new tab)</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Upcoming Events -->
      {upcomingEvents.length > 0 ? (
        <div class="events-section">
          <h2>{eventsPage.data.upcomingEventsTitle}</h2>
          <div class="events-grid">
          {upcomingEvents.map(event => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              href={`/events/${event.slug}`}
            />
          ))}
          </div>
        </div>
      ) : (
        <div class="card no-events">
          <h2>{eventsPage.data.noUpcomingEvents.title}</h2>
          <p>{eventsPage.data.noUpcomingEvents.description}</p>
        </div>
      )}

      <!-- Past Events -->
      {pastEvents.length > 0 && (
        <div class="past-events-section">
          <h2>{eventsPage.data.pastEventsTitle}</h2>
          <div class="events-grid">
          {pastEvents.slice(0, 6).map(event => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              href={`/events/${event.slug}`}
            />
          ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .meeting-reminder {
    max-width: 700px;
    margin: 0 auto var(--space-xl);
    text-align: center;
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary) 100%);
    color: var(--color-white);
  }

  .meeting-reminder h2 {
    color: var(--color-white);
  }

  .meeting-details {
    margin: var(--space-lg) 0;
  }

  .meeting-details p {
    margin-bottom: var(--space-xs);
    font-size: var(--text-md);
  }

  .meeting-details .note {
    font-style: italic;
    opacity: 0.9;
    font-size: var(--text-base);
    margin-top: var(--space-sm);
  }


  .calendar-section {
    max-width: var(--content-wide);
    margin: 0 auto var(--space-xl);
    text-align: center;
  }

  .calendar-embed {
    margin-top: var(--space-lg);
  }

  .calendar-embed iframe {
    border: 0;
    height: 600px;
    border-radius: var(--border-radius);
    box-shadow: var(--shadow);
  }

  .calendar-links {
    margin-top: var(--space-lg);
    text-align: center;
  }

  .events-section, .past-events-section {
    margin-top: var(--space-2xl);
  }

  .events-section h2, .past-events-section h2 {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .past-events-section h2 {
    color: var(--color-gray);
  }

  .past-events-section :global(.event-card) {
    border-left: 3px solid var(--color-light-gray);
    background-color: var(--color-off-white);
  }

  .past-events-section :global(.event-card:hover) {
    background-color: var(--color-white);
  }

  .events-grid {
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .events-grid {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }
  }

  @media (max-width: 768px) {
    .calendar-embed iframe {
      height: 400px;
    }
  }

  .no-events {
    text-align: center;
    max-width: var(--content-narrow);
    margin: var(--space-xl) auto;
    padding: var(--space-2xl);
  }
</style>

