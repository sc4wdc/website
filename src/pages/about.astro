---
import ContentPage from '../layouts/ContentPage.astro';
import { getEntry } from 'astro:content';

const aboutPage = await getEntry('pages', 'about');
if (!aboutPage) throw new Error('About page not found');
const { Content } = await aboutPage.render();
---

<ContentPage title={aboutPage.data.title} description={aboutPage.data.description}>
  <Content />
</ContentPage>
