---
import BaseLayout from '../layouts/BaseLayout.astro';
import clubInfo from '../data/club-info.json';
---

<BaseLayout title="Contact Us" description="Get in touch with Santa Cruz 4 Wheel Drive Club">
  <section class="section">
    <div class="container">
      <h1>Contact Us</h1>
      <p class="intro">
        We'd love to hear from you! The best way to connect with us is through our social media
        channels or by attending one of our monthly meetings.
      </p>

      <div class="contact-grid">
        <!-- Meeting Information -->
        <div class="card contact-card">
          <h2>📅 Monthly Meetings</h2>
          <div class="contact-details">
            <p><strong>When:</strong></p>
            <p>{clubInfo.meeting.schedule}</p>
            <p>{clubInfo.meeting.time}</p>
            <p class="note">{clubInfo.meeting.earlyArrival}</p>

            <p style="margin-top: 1.5rem;"><strong>Where:</strong></p>
            <p>{clubInfo.meeting.location.name}</p>
            <p>
              {clubInfo.meeting.location.address}<br />
              {clubInfo.meeting.location.city}, {clubInfo.meeting.location.state} {clubInfo.meeting.location.zip}
            </p>

            <a
              href={clubInfo.meeting.location.mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn"
              style="margin-top: 1rem;"
            >
              Get Directions
            </a>
          </div>
        </div>

        <!-- Social Media -->
        <div class="card contact-card">
          <h2>💬 Connect Online</h2>
          <div class="contact-details">
            <p>Stay up to date with club activities, events, and trail reports through our social media channels:</p>

            <div class="social-buttons">
              <a
                href={clubInfo.social.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="social-button facebook"
              >
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                <span>Join our Facebook Group</span>
              </a>

              <a
                href={clubInfo.social.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="social-button instagram"
              >
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
                <span>Follow us on Instagram</span>
              </a>
            </div>

            <p style="margin-top: 1.5rem;">
              Our Facebook group is the most active place for discussions,
              trip planning, and connecting with members between meetings.
            </p>
          </div>
        </div>
      </div>

      <!-- Map Section -->
      <div class="map-section">
        <h2>Meeting Location</h2>
        <div class="map-container">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3189.8445872698285!2d-121.78502522415612!3d36.917980072213695!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x808e1aee2193910b%3A0x7f8664073d599e1f!2sRound%20Table%20Pizza!5e0!3m2!1sen!2sus!4v1764211758702!5m2!1sen!2sus"
            width="100%"
            height="450"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Round Table Pizza Watsonville Location"
          ></iframe>
        </div>
        <p class="map-caption">
          {clubInfo.meeting.location.name}, {clubInfo.meeting.location.address},
          {clubInfo.meeting.location.city}, {clubInfo.meeting.location.state} {clubInfo.meeting.location.zip}
        </p>
      </div>

      <!-- Additional Info -->
      <div class="card contact-info">
        <h2>New Members Welcome!</h2>
        <p>
          First time? Don't be shy! Our meetings are informal and welcoming.
          Come introduce yourself, ask questions, and learn about upcoming events.
          We're always excited to meet new people who share our passion for off-roading
          and public lands stewardship.
        </p>
        <p>
          No commitment required to attend a meeting - come check us out and see if
          {clubInfo.clubName} is the right fit for you!
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    text-align: center;
    font-size: 1.125rem;
    max-width: 700px;
    margin: 0 auto var(--space-xl);
    color: var(--color-gray);
  }

  .contact-grid {
    display: grid;
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .contact-card h2 {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .contact-details p {
    margin-bottom: var(--space-xs);
  }

  .contact-details .note {
    font-style: italic;
    color: var(--color-gray);
  }

  .social-buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .social-button {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md);
    border-radius: var(--border-radius);
    color: var(--color-white);
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .social-button:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    color: var(--color-white);
  }

  .social-button.facebook {
    background-color: #1877f2;
  }

  .social-button.facebook:hover {
    background-color: #145dbf;
  }

  .social-button.instagram {
    background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
  }

  .social-button svg {
    flex-shrink: 0;
  }

  .map-section {
    margin: var(--space-2xl) 0;
  }

  .map-section h2 {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .map-container {
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    margin-bottom: var(--space-md);
  }

  .map-caption {
    text-align: center;
    color: var(--color-gray);
    font-size: 0.95rem;
  }

  .contact-info {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
</style>

