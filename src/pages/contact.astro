---
import BaseLayout from '../layouts/BaseLayout.astro';
import FacebookIcon from '../components/icons/FacebookIcon.astro';
import InstagramIcon from '../components/icons/InstagramIcon.astro';
import { SITE, MEETING, SOCIAL } from '../consts';
const { embedMapUrl } = MEETING.location;
---

<BaseLayout title="Contact Us" description="Get in touch with Santa Cruz 4 Wheel Drive Club">
  <section class="section">
    <div class="container">
      <h1>Contact Us</h1>
      <p class="intro">
        We'd love to hear from you! The best way to connect with us is through our social media
        channels or by attending one of our monthly meetings.
      </p>

      <div class="contact-grid">
        <!-- Meeting Information -->
        <div class="card contact-card">
          <h2><span aria-hidden="true">📅 </span>Monthly Meetings</h2>
          <div class="contact-details">
            <p><strong>When:</strong></p>
            <p>{MEETING.schedule}</p>
            <p>{MEETING.time}</p>
            <p class="note">{MEETING.earlyArrival}</p>

            <p class="where-label"><strong>Where:</strong></p>
            <p>{MEETING.location.name}</p>
            <p>
              {MEETING.location.address}<br />
              {MEETING.location.city}, {MEETING.location.state} {MEETING.location.zip}
            </p>

            <a
              href={MEETING.location.mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn"
              
            >
              Get Directions <span class="sr-only">(opens in new tab)</span>
            </a>
          </div>
        </div>

        <!-- Social Media -->
        <div class="card contact-card">
          <h2><span aria-hidden="true">💬 </span>Connect Online</h2>
          <div class="contact-details">
            <p>Stay up to date with club activities, events, and trail reports through our social media channels:</p>

            <div class="social-buttons">
              <a
                href={SOCIAL.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="social-button facebook"
              >
                <FacebookIcon />
                <span>Join our Facebook Group <span class="sr-only">(opens in new tab)</span></span>
              </a>

              <a
                href={SOCIAL.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="social-button instagram"
              >
                <InstagramIcon />
                <span>Follow us on Instagram <span class="sr-only">(opens in new tab)</span></span>
              </a>
            </div>

            <p class="social-note">
              Our Facebook group is the most active place for discussions,
              trip planning, and connecting with members between meetings.
            </p>
          </div>
        </div>
      </div>

      <!-- Map Section -->
      <div class="map-section">
        <h2>Meeting Location</h2>
        <div class="map-container">
          <iframe
            src={embedMapUrl}
            width="100%"
            height="450"
            
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Round Table Pizza Watsonville Location"
          ></iframe>
        </div>
        <p class="map-caption">
          {MEETING.location.name}, {MEETING.location.address},
          {MEETING.location.city}, {MEETING.location.state} {MEETING.location.zip}
        </p>
      </div>

      <!-- Additional Info -->
      <div class="card contact-info">
        <h2>New Members Welcome!</h2>
        <p>
          First time? Don't be shy! Our meetings are informal and welcoming.
          Come introduce yourself, ask questions, and learn about upcoming events.
          We're always excited to meet new people who share our passion for off-roading
          and public lands stewardship.
        </p>
        <p>
          No commitment required to attend a meeting - come check us out and see if
          {SITE.name} is the right fit for you!
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .contact-card h2 {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .contact-details p {
    margin-bottom: var(--space-xs);
  }

  .contact-details .note {
    font-style: italic;
    color: var(--color-gray);
  }

  .where-label {
    margin-top: var(--space-md);
  }

  .contact-details .btn {
    margin-top: var(--space-sm);
  }

  .social-note {
    margin-top: var(--space-md);
  }

  .social-buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .social-button {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md);
    border-radius: var(--border-radius);
    color: var(--color-white);
    font-weight: 600;
    transition: all var(--transition-base);
  }

  .social-button:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    color: var(--color-white);
  }

  .social-button.facebook {
    background-color: var(--color-facebook);
  }

  .social-button.facebook:hover {
    background-color: var(--color-facebook);
    filter: brightness(0.85);
  }

  .social-button.instagram {
    background: linear-gradient(45deg, #c2185b 0%, #ad1457 50%, #8e24aa 100%);
  }

  .social-button svg {
    flex-shrink: 0;
  }

  .map-section {
    margin: var(--space-2xl) 0;
  }

  .map-section h2 {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .map-container {
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    margin-bottom: var(--space-md);
  }

  .map-container iframe {
    border: 0;
  }

  .map-caption {
    text-align: center;
    color: var(--color-gray);
    font-size: var(--text-base);
  }

  .contact-info {
    max-width: var(--content-medium);
    margin: 0 auto;
    text-align: center;
  }
</style>

