---
import BaseLayout from '../layouts/BaseLayout.astro';
import FacebookIcon from '../components/icons/FacebookIcon.astro';
import InstagramIcon from '../components/icons/InstagramIcon.astro';
import { getEntry } from 'astro:content';
import { getSiteSettings } from '../utils/site';

const [contactPage, siteSettings] = await Promise.all([
  getEntry('pages', 'contact'),
  getSiteSettings(),
]);

if (!contactPage || contactPage.data.pageType !== 'contact') {
  throw new Error('Contact page content not found');
}

const { meeting, social } = siteSettings;
const { embedMapUrl } = meeting.location;
---

<BaseLayout title={contactPage.data.title} description={contactPage.data.description}>
  <section class="section">
    <div class="container">
      <h1>{contactPage.data.title}</h1>
      <p class="intro">{contactPage.data.intro}</p>

      <div class="contact-grid">
        <!-- Meeting Information -->
        <div class="card contact-card">
          <h2><span aria-hidden="true">📅 </span>{contactPage.data.meetingSection.title}</h2>
          <div class="contact-details">
            <p><strong>{contactPage.data.meetingSection.whenLabel}:</strong></p>
            <p>{meeting.schedule}</p>
            <p>{meeting.time}</p>
            <p class="note">{meeting.earlyArrival}</p>

            <p class="where-label"><strong>{contactPage.data.meetingSection.whereLabel}:</strong></p>
            <p>{meeting.location.name}</p>
            <p>
              {meeting.location.address}<br />
              {meeting.location.city}, {meeting.location.state} {meeting.location.zip}
            </p>

            <a
              href={meeting.location.mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn"
              
            >
              {contactPage.data.meetingSection.directionsLabel} <span class="sr-only">(opens in new tab)</span>
            </a>
          </div>
        </div>

        <!-- Social Media -->
        <div class="card contact-card">
          <h2><span aria-hidden="true">💬 </span>{contactPage.data.onlineSection.title}</h2>
          <div class="contact-details">
            <p>{contactPage.data.onlineSection.intro}</p>

            <div class="social-buttons">
              <a
                href={social.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="social-button facebook"
              >
                <FacebookIcon />
                <span>{contactPage.data.onlineSection.facebookLabel} <span class="sr-only">(opens in new tab)</span></span>
              </a>

              <a
                href={social.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="social-button instagram"
              >
                <InstagramIcon />
                <span>{contactPage.data.onlineSection.instagramLabel} <span class="sr-only">(opens in new tab)</span></span>
              </a>
            </div>

            <p class="social-note">
              {contactPage.data.onlineSection.note}
            </p>
          </div>
        </div>
      </div>

      <!-- Map Section -->
      <div class="map-section">
        <h2>{contactPage.data.mapSectionTitle}</h2>
        <div class="map-container">
          <iframe
            src={embedMapUrl}
            width="100%"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Round Table Pizza Watsonville Location"
          ></iframe>
        </div>
        <p class="map-caption">
          {meeting.location.name}, {meeting.location.address},
          {meeting.location.city}, {meeting.location.state} {meeting.location.zip}
        </p>
      </div>

      <!-- Additional Info -->
      <div class="card contact-info">
        <h2>{contactPage.data.welcomeSection.title}</h2>
        {contactPage.data.welcomeSection.paragraphs.map(paragraph => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .contact-card h2 {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .contact-details p {
    margin-bottom: var(--space-xs);
  }

  .contact-details .note {
    font-style: italic;
    color: var(--color-gray);
  }

  .where-label {
    margin-top: var(--space-md);
  }

  .contact-details .btn {
    margin-top: var(--space-sm);
  }

  .social-note {
    margin-top: var(--space-md);
  }

  .social-buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .social-button {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md);
    border-radius: var(--border-radius);
    color: var(--color-white);
    font-weight: 600;
    transition: all var(--transition-base);
  }

  .social-button:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    color: var(--color-white);
  }

  .social-button.facebook {
    background-color: var(--color-facebook);
  }

  .social-button.facebook:hover {
    background-color: var(--color-facebook);
    filter: brightness(0.85);
  }

  .social-button.instagram {
    background: linear-gradient(45deg, #c2185b 0%, #ad1457 50%, #8e24aa 100%);
  }

  .social-button.instagram:hover {
    filter: brightness(0.85);
  }

  .social-button svg {
    flex-shrink: 0;
  }

  .map-section {
    margin: var(--space-2xl) 0;
  }

  .map-section h2 {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .map-container {
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    margin-bottom: var(--space-md);
  }

  .map-container iframe {
    border: 0;
    height: 450px;
  }

  .map-caption {
    text-align: center;
    color: var(--color-gray);
    font-size: var(--text-base);
  }

  .contact-info {
    max-width: var(--content-medium);
    margin: 0 auto;
    text-align: center;
  }

  @media (max-width: 768px) {
    .map-container iframe {
      height: 300px;
    }
  }
</style>

