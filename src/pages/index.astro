---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import TrailCard from '../components/TrailCard.astro';
import { getCollection, getEntry } from 'astro:content';
import { parseLocalDate, getTodayLocal } from '../utils/date';
import { getSiteSettings } from '../utils/site';
import { getAllEvents } from '../utils/events';

const [allEvents, allTrails, homePage, siteSettings] = await Promise.all([
  getAllEvents(),
  getCollection('trails'),
  getEntry('pages', 'home'),
  getSiteSettings(),
]);

if (!homePage || homePage.data.pageType !== 'home') {
  throw new Error('Home page content not found');
}

const today = getTodayLocal();
const upcomingEvents = allEvents
  .filter(event => parseLocalDate(event.data.date) >= today)
  .sort((a, b) => parseLocalDate(a.data.date).getTime() - parseLocalDate(b.data.date).getTime())
  .slice(0, 3);

const recentTrails = allTrails
  .sort((a, b) => parseLocalDate(b.data.date).getTime() - parseLocalDate(a.data.date).getTime())
  .slice(0, 3);

const { meeting, site } = siteSettings;
const heroImage = homePage.data.hero.image;

function isExternalLink(href: string): boolean {
  return /^https?:\/\//.test(href);
}
---

<BaseLayout title={homePage.data.title} description={homePage.data.description}>
  <!-- Hero Section -->
  <section class:list={["hero", { "hero-with-image": !!heroImage }]}>
    {heroImage && (
      <Image
        src={heroImage}
        alt=""
        class="hero-bg"
        widths={[640, 1024, 1600]}
        sizes="100vw"
        loading="eager"
      />
    )}
    <div class="container">
      <div class="hero-content">
        <h1>{site.name}</h1>
        <p class="hero-tagline">{site.tagline}</p>
        <p class="hero-description">{homePage.data.hero.description}</p>
        <div class="hero-actions">
          <a href={homePage.data.hero.primaryCta.href} class="btn">{homePage.data.hero.primaryCta.label}</a>
          <a href={homePage.data.hero.secondaryCta.href} class="btn btn-secondary">{homePage.data.hero.secondaryCta.label}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Monthly Meeting Info -->
  <section class="section meeting-info">
    <div class="container">
      <div class="card meeting-card">
        <h2><span aria-hidden="true">📅 </span>{homePage.data.meetings.title}</h2>
        <div class="meeting-details">
          <div class="meeting-item">
            <strong>{homePage.data.meetings.whenLabel}:</strong> {meeting.schedule} at {meeting.time}
          </div>
          <div class="meeting-item">
            <strong>{homePage.data.meetings.whereLabel}:</strong> {meeting.location.name}, {meeting.location.address},
            {meeting.location.city}, {meeting.location.state}
          </div>
          <div class="meeting-item">
            <em>{meeting.earlyArrival}</em>
          </div>
        </div>
        {homePage.data.meetings.firstVisitNote && (
          <p class="first-visit-note">{homePage.data.meetings.firstVisitNote}</p>
        )}
        <a href="/contact" class="btn meeting-cta">{homePage.data.meetings.directionsLabel}</a>
      </div>
    </div>
  </section>

  <!-- Upcoming Events -->
  {upcomingEvents.length > 0 && (
    <section class="section events-preview">
      <div class="container">
        <h2>{homePage.data.upcomingEvents.title}</h2>
        <div class="events-grid">
          {upcomingEvents.map(event => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              href={`/events/${event.id}`}
              cancelled={event.data.cancelled}
            />
          ))}
        </div>
        <div class="section-cta">
          <a href="/events" class="btn">{homePage.data.upcomingEvents.ctaLabel}</a>
        </div>
      </div>
    </section>
  )}

  <!-- Recent Trail Reports -->
  {recentTrails.length > 0 && (
    <section class="section trails-preview">
      <div class="container">
        <h2>{homePage.data.recentTrails.title}</h2>
        <div class="trails-grid">
          {recentTrails.map(trail => (
            <TrailCard
              title={trail.data.title}
              difficulty={trail.data.difficulty}
              location={trail.data.location}
              description={trail.data.description}
              href={`/trails/${trail.id}`}
            />
          ))}
        </div>
        <div class="section-cta">
          <a href="/trails" class="btn">{homePage.data.recentTrails.ctaLabel}</a>
        </div>
      </div>
    </section>
  )}

  <!-- Call to Action -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>{homePage.data.cta.title}</h2>
        <p>{homePage.data.cta.description}</p>
        <div class="cta-actions">
          <a href={homePage.data.cta.primaryCta.href} class="btn btn-inverse">{homePage.data.cta.primaryCta.label}</a>
          <a
            href={homePage.data.cta.secondaryCta.href}
            target={isExternalLink(homePage.data.cta.secondaryCta.href) ? '_blank' : undefined}
            rel={isExternalLink(homePage.data.cta.secondaryCta.href) ? 'noopener noreferrer' : undefined}
            class="btn btn-secondary"
          >
            {homePage.data.cta.secondaryCta.label}
            {isExternalLink(homePage.data.cta.secondaryCta.href) && (
              <span class="sr-only">(opens in new tab)</span>
            )}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
    color: var(--color-white);
    padding: var(--space-2xl) 0;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero-with-image {
    background: none;
  }

  .hero-with-image::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(45, 80, 22, 0.5) 0%, rgba(45, 80, 22, 0.3) 100%);
    z-index: 1;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 70%;
  }

  .hero-content {
    max-width: var(--content-medium);
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .hero h1 {
    color: var(--color-white);
    font-size: clamp(2rem, 6vw, 3.5rem);
    margin-bottom: var(--space-md);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  }

  .hero-tagline {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--color-white);
    font-style: italic;
    margin-bottom: var(--space-lg);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }

  .hero-description {
    font-size: var(--text-lg);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .meeting-info {
    background-color: var(--color-light-gray);
  }

  .meeting-card {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .meeting-card h2 {
    text-align: center;
  }

  .first-visit-note {
    margin-top: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border-left: 3px solid var(--color-accent);
    background-color: var(--color-off-white);
    border-radius: 0 var(--border-radius) var(--border-radius) 0;
    font-style: italic;
    color: var(--color-secondary);
    text-align: left;
  }

  .meeting-cta {
    margin-top: var(--space-sm);
  }

  .section-cta {
    text-align: center;
    margin-top: var(--space-lg);
  }

  .meeting-details {
    margin: var(--space-lg) 0;
  }

  .meeting-item {
    margin-bottom: var(--space-sm);
    font-size: var(--text-md);
  }

  .events-grid {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  @media (min-width: 768px) {
    .events-grid {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }
  }

  .trails-preview {
    background-color: var(--color-light-gray);
  }

  .trails-grid {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  @media (min-width: 768px) {
    .trails-grid {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }
  }

  .cta-section {
    background: linear-gradient(135deg, var(--color-secondary) 0%, var(--color-accent) 100%);
    color: var(--color-white);
    text-align: center;
  }

  .cta-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .cta-section h2 {
    color: var(--color-white);
  }

  .cta-section p {
    font-size: var(--text-lg);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
    opacity: 0.95;
  }

  .cta-actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-section .btn-secondary {
    background-color: transparent;
    color: var(--color-white);
    border-color: var(--color-white);
  }

  .cta-section .btn-secondary:hover {
    background-color: var(--color-white);
    color: var(--color-primary);
  }

  @media (orientation: landscape) and (max-height: 500px) {
    .hero {
      padding: var(--space-lg) 0;
    }
  }
</style>

