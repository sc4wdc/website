---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { getBoardMembers } from '../utils/site';

const [boardPage, boardMembers] = await Promise.all([
  getEntry('pages', 'board'),
  getBoardMembers(),
]);

if (!boardPage || boardPage.data.pageType !== 'board') {
  throw new Error('Board page not found');
}

const { Content } = await boardPage.render();
---

<BaseLayout title={boardPage.data.title} description={boardPage.data.description}>
  <section class="section">
    <div class="container">
      <h1>{boardPage.data.title}</h1>
      <p class="intro">{boardPage.data.intro}</p>

      <div class="board-grid">
        {boardMembers.map(member => (
          <div class="board-member card">
            <div class="member-photo-placeholder">
              {member.photo ? (
                <img
                  src={member.photo}
                  alt={`${member.name}, ${member.position}`}
                  class="member-photo"
                />
              ) : (
                <svg width="120" height="120" viewBox="0 0 120 120" fill="none" aria-hidden="true" focusable="false">
                  <circle cx="60" cy="60" r="60" fill="var(--color-light-gray)"/>
                  <circle cx="60" cy="45" r="20" fill="var(--color-gray)"/>
                  <path d="M20 100 C20 75, 40 65, 60 65 C80 65, 100 75, 100 100" fill="var(--color-gray)"/>
                </svg>
              )}
            </div>
            <h2>{member.name}</h2>
            <p class="position">{member.position}</p>
            <div class="contact-info">
              <a href={`mailto:${member.email}`} class="contact-link">
                <span aria-hidden="true">📧 </span>{member.email}
              </a>
              {member.phone && (
                <a href={`tel:${member.phone.replace(/[^0-9]/g, '')}`} class="contact-link">
                  <span aria-hidden="true">📱 </span>{member.phone}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>

      <div class="board-info card prose">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .board-grid {
    display: grid;
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 640px) {
    .board-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .board-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .board-member {
    text-align: center;
    padding: var(--space-xl) var(--space-lg);
  }

  .member-photo-placeholder {
    margin: 0 auto var(--space-lg);
    width: 120px;
    height: 120px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-light-gray);
  }

  .member-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .board-member h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-xs);
  }

  .position {
    color: var(--color-accent);
    font-weight: 600;
    font-size: var(--text-base);
    margin: 0 0 var(--space-md) 0;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-light-gray);
  }

  .contact-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-xs);
    font-size: var(--text-base);
    color: var(--color-primary);
    transition: color var(--transition-fast);
    overflow-wrap: anywhere;
  }

  .contact-link:hover {
    color: var(--color-accent);
  }

  .board-info {
    max-width: var(--content-medium);
    margin: 0 auto;
  }

  .board-info h2 {
    text-align: center;
  }

  .board-info h3 {
    margin-top: var(--space-lg);
    color: var(--color-secondary);
  }
</style>

