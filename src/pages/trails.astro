---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrailCard from '../components/TrailCard.astro';
import { getCollection, getEntry } from 'astro:content';

const [allTrails, trailsPage] = await Promise.all([
  getCollection('trails'),
  getEntry('pages', 'trails'),
]);

if (!trailsPage || trailsPage.data.pageType !== 'trails') {
  throw new Error('Trails page content not found');
}

const trails = allTrails.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={trailsPage.data.title} description={trailsPage.data.description}>
  <section class="section">
    <div class="container">
      <h1>{trailsPage.data.title}</h1>
      <p class="intro">{trailsPage.data.intro}</p>

      <!-- Trail Reports Grid -->
      {trails.length > 0 ? (
        <div class="trails-grid">
          {trails.map(trail => (
            <TrailCard
              title={trail.data.title}
              difficulty={trail.data.difficulty}
              location={trail.data.location}
              description={trail.data.description}
              href={`/trails/${trail.slug}`}
            />
          ))}
        </div>
      ) : (
        <div class="card no-trails">
          <h2>{trailsPage.data.noTrails.title}</h2>
          <p>{trailsPage.data.noTrails.description}</p>
        </div>
      )}

      <!-- Call to Action for Members -->
      <div class="card contribute-section">
        <h2>{trailsPage.data.contributeSection.title}</h2>
        {trailsPage.data.contributeSection.paragraphs.map(paragraph => (
          <p>{paragraph}</p>
        ))}
      </div>

      <!-- Trail Difficulty Guide -->
      <div class="card difficulty-guide">
        <h2>{trailsPage.data.difficultyGuide.title}</h2>
        <div class="difficulty-list">
          {trailsPage.data.difficultyGuide.levels.map(level => (
            <div class="difficulty-item">
              <span class={`difficulty-badge difficulty-${level.level.toLowerCase()}`}>{level.level}</span>
              <p>{level.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    margin-bottom: var(--space-2xl);
  }

  .trails-grid {
    display: grid;
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 640px) {
    .trails-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .trails-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .no-trails {
    text-align: center;
    max-width: var(--content-narrow);
    margin: var(--space-xl) auto;
    padding: var(--space-2xl);
  }

  .contribute-section {
    max-width: var(--content-medium);
    margin: 0 auto var(--space-xl);
    text-align: center;
    background-color: var(--color-light-gray);
  }

  .difficulty-guide {
    max-width: var(--content-medium);
    margin: 0 auto;
  }

  .difficulty-guide h2 {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .difficulty-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .difficulty-item {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    background-color: var(--color-off-white);
    border-radius: var(--border-radius);
  }

  @media (max-width: 640px) {
    .difficulty-item {
      flex-direction: column;
      text-align: center;
    }
  }

  .difficulty-badge {
    flex-shrink: 0;
  }

  .difficulty-item p {
    margin: 0;
    flex: 1;
  }
</style>

