---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../utils/date';

export async function getStaticPaths() {
  const trails = await getCollection('trails');
  return trails.map(trail => ({
    params: { slug: trail.id },
    props: { trail },
  }));
}

const { trail } = Astro.props;
const { Content } = await render(trail);
---

<BaseLayout title={trail.data.title} description={trail.data.description}>
  <section class="section">
    <div class="container">
      <article class="trail-detail">
        <div class="trail-header">
          <h1>{trail.data.title}</h1>
          <div class="trail-meta-grid">
            <div class="meta-card">
              <strong>Difficulty</strong>
              <span class={`difficulty-badge difficulty-${trail.data.difficulty.toLowerCase()}`}>
                {trail.data.difficulty}
              </span>
            </div>
            <div class="meta-card">
              <strong>Location</strong>
              <span><span aria-hidden="true">📍 </span>{trail.data.location}</span>
            </div>
            <div class="meta-card">
              <strong>Date</strong>
              <span><span aria-hidden="true">📅 </span>{formatDate(trail.data.date)}</span>
            </div>
            {trail.data.distance && (
              <div class="meta-card">
                <strong>Distance</strong>
                <span><span aria-hidden="true">📏 </span>{trail.data.distance}</span>
              </div>
            )}
            {trail.data.duration && (
              <div class="meta-card">
                <strong>Duration</strong>
                <span><span aria-hidden="true">⏱️ </span>{trail.data.duration}</span>
              </div>
            )}
            {trail.data.author && (
              <div class="meta-card">
                <strong>Author</strong>
                <span><span aria-hidden="true">✍️ </span>{trail.data.author}</span>
              </div>
            )}
          </div>
        </div>

        <div class="trail-content prose">
          <Content />
        </div>

        <div class="back-link">
          <a href="/trails">← Back to All Trail Reports</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .trail-detail {
    max-width: var(--content-wide);
    margin: 0 auto;
  }

  .trail-header {
    margin-bottom: var(--space-xl);
  }

  .trail-header h1 {
    margin-bottom: var(--space-lg);
  }

  .trail-meta-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .meta-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
    background-color: var(--color-light-gray);
    border-radius: var(--border-radius);
  }

  .meta-card strong {
    font-size: var(--text-sm);
    text-transform: uppercase;
    color: var(--color-gray);
    letter-spacing: 0.5px;
  }

  .meta-card span {
    font-size: var(--text-md);
    color: var(--color-dark);
  }

  .difficulty-badge {
    display: inline-block;
  }

  .trail-content {
    background-color: var(--color-white);
    padding: var(--space-xl);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow);
    margin-bottom: var(--space-xl);
  }

</style>

