{
  "name": "sc4wdc-website",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "test": "vitest run",
    "lint": "npm run lint:types && npm run lint:js && npm run lint:css",
    "lint:types": "astro check",
    "lint:js": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.{astro,css}\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{astro,css}\" --fix",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.1",
    "astro": "^5.17.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@eslint/js": "^10.0.1",
    "astro-eslint-parser": "^1.3.0",
    "eslint": "^10.0.3",
    "eslint-plugin-astro": "^1.6.0",
    "globals": "^17.4.0",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0"
  }
}
